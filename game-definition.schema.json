{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forgesworn/nostr-game-controller/blob/main/game-definition.schema.json",
  "title": "Gamestr game definition v2 with controller profile",
  "type": "object",
  "$defs": {
    "secureWebUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])([:/]|$))"
    },
    "controllerProfile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/forgesworn/nostr-game-controller/blob/main/controller-profile.schema.json",
      "title": "Experimental Nostr game controller profile v1",
      "type": "object",
      "required": [
        "version",
        "name",
        "slots"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "slots": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "enum": [
              "joyL",
              "joyR",
              "A",
              "B",
              "X",
              "Y",
              "L1",
              "L2",
              "R1",
              "R2",
              "start",
              "select",
              "dpadU",
              "dpadD",
              "dpadL",
              "dpadR"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "heading",
                  "xy",
                  "tilt"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 48
              },
              "icon": {
                "type": "string",
                "maxLength": 64
              },
              "colour": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
              },
              "tapAction": {
                "enum": [
                  "joyL",
                  "joyR",
                  "A",
                  "B",
                  "X",
                  "Y",
                  "L1",
                  "L2",
                  "R1",
                  "R2",
                  "start",
                  "select",
                  "dpadU",
                  "dpadD",
                  "dpadL",
                  "dpadR"
                ]
              },
              "graphic": {
                "type": "object",
                "required": [
                  "png"
                ],
                "properties": {
                  "png": {
                    "type": "string",
                    "maxLength": 12288,
                    "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                  }
                }
              }
            }
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
            }
          }
        },
        "layout": {
          "type": "object",
          "required": [
            "version"
          ],
          "anyOf": [
            {
              "required": [
                "portrait"
              ]
            },
            {
              "required": [
                "landscape"
              ]
            }
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "portrait": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "joyL",
                  "joyR",
                  "A",
                  "B",
                  "X",
                  "Y",
                  "L1",
                  "L2",
                  "R1",
                  "R2",
                  "start",
                  "select",
                  "dpadU",
                  "dpadD",
                  "dpadL",
                  "dpadR"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "size"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "size": {
                    "type": "number",
                    "minimum": 48,
                    "maximum": 192
                  },
                  "shape": {
                    "enum": [
                      "circle",
                      "rounded"
                    ]
                  },
                  "zone": {
                    "type": "object",
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
                      },
                      "height": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            },
            "landscape": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "joyL",
                  "joyR",
                  "A",
                  "B",
                  "X",
                  "Y",
                  "L1",
                  "L2",
                  "R1",
                  "R2",
                  "start",
                  "select",
                  "dpadU",
                  "dpadD",
                  "dpadL",
                  "dpadR"
                ]
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "size"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "size": {
                    "type": "number",
                    "minimum": 48,
                    "maximum": 192
                  },
                  "shape": {
                    "enum": [
                      "circle",
                      "rounded"
                    ]
                  },
                  "zone": {
                    "type": "object",
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
                      },
                      "height": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "$comment": "Runtime validators additionally enforce 48 KiB UTF-8, total artwork 32768 characters, PNG dimensions <=256, stick size >=96, stick-only zones, complete maps, bounded zones and viewport collision fallback. Unknown extension fields are ignored within the total limit."
    }
  },
  "required": [
    "manifestVersion",
    "name",
    "gameId"
  ],
  "properties": {
    "manifestVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "maxLength": 1200
    },
    "developer": {
      "type": "string",
      "maxLength": 100
    },
    "tips": {
      "type": "string",
      "minLength": 6,
      "maxLength": 320
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "uniqueItems": true,
      "maxItems": 8
    },
    "url": {
      "$ref": "#/$defs/secureWebUrl"
    },
    "exec": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "order": {
      "type": "number"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "logoUrl": {
      "$ref": "#/$defs/secureWebUrl"
    },
    "heroUrl": {
      "$ref": "#/$defs/secureWebUrl"
    },
    "textLogo": {
      "type": "boolean"
    },
    "downloadOnly": {
      "type": "boolean"
    },
    "downloadUrl": {
      "$ref": "#/$defs/secureWebUrl"
    },
    "operatorOnly": {
      "type": "boolean"
    },
    "inputModes": {
      "type": "array",
      "items": {
        "enum": [
          "gamepad",
          "keyboard",
          "pointer",
          "touch"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "controller": {
      "type": "object",
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "native",
            "keyboard",
            "pointer",
            "hybrid"
          ]
        },
        "certification": {
          "type": "object",
          "required": [
            "level",
            "testedAt",
            "hardware",
            "profiles",
            "gameRevision"
          ],
          "properties": {
            "level": {
              "enum": [
                "desk",
                "hardware"
              ]
            },
            "testedAt": {
              "type": "string",
              "format": "date"
            },
            "hardware": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 8
            },
            "profiles": {
              "type": "array",
              "items": {
                "enum": [
                  "standard",
                  "linux-hat"
                ]
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 2
            },
            "gameRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "notes": {
              "type": "string",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "phoneProtocol": {
          "const": "gamestr-controller-v1"
        },
        "profile": {
          "$ref": "https://github.com/forgesworn/nostr-game-controller/blob/main/controller-profile.schema.json"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "profile"
            ]
          },
          "then": {
            "required": [
              "phoneProtocol"
            ]
          }
        }
      ]
    },
    "controlHints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "maxItems": 8
    },
    "controls": {
      "type": "object",
      "properties": {
        "up": {
          "type": "string"
        },
        "down": {
          "type": "string"
        },
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "fire": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sessionMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "players": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "network": {
      "enum": [
        "required",
        "optional",
        "offline"
      ]
    },
    "conferenceFallback": {
      "type": "boolean"
    },
    "ageRating": {
      "type": "string",
      "maxLength": 32
    },
    "allowedOrigins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secureWebUrl"
      },
      "uniqueItems": true,
      "maxItems": 12
    },
    "nostrHandoff": {
      "type": "object",
      "required": [
        "protocol",
        "editions",
        "signKinds"
      ],
      "properties": {
        "protocol": {
          "const": "gamestr-auth-v1"
        },
        "editions": {
          "type": "array",
          "items": {
            "enum": [
              "600",
              "gamestr"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "signKinds": {
          "type": "array",
          "items": {
            "enum": [
              30762,
              5555,
              27235
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "nostrSign": {
          "type": "boolean"
        },
        "walletPay": {
          "type": "boolean"
        },
        "persistentStorage": {
          "type": "boolean"
        },
        "externalNavigation": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rewardRules": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      },
      "additionalProperties": false
    },
    "tHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scoreAuthorities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "scoreKind": {
      "type": "integer"
    },
    "scoreField": {
      "type": "string"
    },
    "scoreDir": {
      "enum": [
        "asc",
        "desc"
      ]
    },
    "source": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "url"
      ]
    },
    {
      "required": [
        "exec"
      ]
    }
  ],
  "additionalProperties": false
}
